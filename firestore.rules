rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Posts collection - allow reads to everyone
    match /posts/{postID} {
      allow read: if request.auth != null || request.auth == null;
      allow write: if false; // Only backend functions can write
    }

    // User posts - track which posts a user has made
    match /users/{userID}/posts/{postID} {
      allow read: if request.auth.uid == userID || resource == null;
      allow write: if request.auth.uid == userID;
    }

    // User location history
    match /users/{userID}/locationHistory/{doc} {
      allow read: if request.auth.uid == userID;
      allow write: if request.auth.uid == userID;
    }

    // Comments on posts
    match /posts/{postID}/comments/{commentID} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.authorID == request.auth.uid;
      allow update, delete: if request.auth.uid == resource.data.authorID;
    }

    // Likes on posts
    match /posts/{postID}/likes/{userID} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userID;
    }
  }
}
